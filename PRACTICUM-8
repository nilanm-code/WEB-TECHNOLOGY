<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Digital Library</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
        }

        /* Navigation */
        nav {
            background-color: #222;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-size: 16px;
        }

        /* Header */
        header {
            background-color: #4CAF50;
            color: white;
            text-align: center;
            padding: 40px;
        }

        header h1 {
            margin: 0;
        }

        /* Sections */
        section {
            padding: 30px;
            max-width: 1100px;
            margin: auto;
        }

        h2 {
            text-align: center;
            color: #333;
        }

        /* Categories */
        .categories {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .category {
            background-color: white;
            padding: 20px;
            width: 180px;
            text-align: center;
            border-radius: 8px;
            box-shadow: 0 2px 5px gray;
        }

        /* Book table */
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        /* Facilities */
        .facilities {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .facility {
            background-color: white;
            padding: 20px;
            width: 200px;
            text-align: center;
            border-radius: 8px;
        }

        /* Form */
        form {
            background-color: white;
            padding: 25px;
            max-width: 500px;
            margin: auto;
            border-radius: 8px;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
        }

        /* Footer */
        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 15px;
        }

        /* Responsive Design */
        @media (max-width: 768px) {

            nav a {
                display: block;
                margin: 8px;
            }

            .category,
            .facility {
                width: 45%;
            }

            table {
                font-size: 14px;
            }
        }

        @media (max-width: 480px) {

            header {
                padding: 25px;
            }

            section {
                padding: 20px;
            }

            .category,
            .facility {
                width: 100%;
            }

            table {
                font-size: 12px;
            }

            th, td {
                padding: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#books">Books</a>
        <a href="#categories">Categories</a>
        <a href="#facilities">Facilities</a>
        <a href="#membership">Membership</a>
    </nav>

    <!-- Header -->
    <header id="home">
        <h1>Digital Library</h1>
        <p>Books and Digital Resources for Students and Faculty</p>
    </header>

    <!-- Categories -->
    <section id="categories">
        <h2>Book Categories</h2>

        <div class="categories">

            <div class="category">
                <h3>Programming</h3>
                <p>C, C++, Python</p>
            </div>

            <div class="category">
                <h3>AI & ML</h3>
                <p>Artificial Intelligence</p>
            </div>

            <div class="category">
                <h3>Web Technology</h3>
                <p>HTML, CSS, JavaScript</p>
            </div>

            <div class="category">
                <h3>Data Science</h3>
                <p>Data Analysis</p>
            </div>

        </div>
    </section>

    <!-- Books -->
    <section id="books">
        <h2>Available Books</h2>

        <table>
            <tr>
                <th>Book Name</th>
                <th>Author</th>
                <th>Category</th>
                <th>Availability</th>
            </tr>

            <tr>
                <td>Python Programming</td>
                <td>Mark Lutz</td>
                <td>Programming</td>
                <td>Available</td>
            </tr>

            <tr>
                <td>Artificial Intelligence</td>
                <td>Stuart Russell</td>
                <td>AI & ML</td>
                <td>Available</td>
            </tr>

            <tr>
                <td>HTML and CSS</td>
                <td>Jon Duckett</td>
                <td>Web Technology</td>
                <td>Issued</td>
            </tr>

            <tr>
                <td>Data Science</td>
                <td>Joel Grus</td>
                <td>Data Science</td>
                <td>Available</td>
            </tr>
        </table>
    </section>

    <!-- Facilities -->
    <section id="facilities">
        <h2>Library Facilities</h2>

        <div class="facilities">

            <div class="facility">
                <h3>📚 E-Books</h3>
                <p>Access digital books.</p>
            </div>

            <div class="facility">
                <h3>🌐 Wi-Fi</h3>
                <p>Free internet access.</p>
            </div>

            <div class="facility">
                <h3>💻 Computer Lab</h3>
                <p>Computers for students.</p>
            </div>

            <div class="facility">
                <h3>📖 Reading Room</h3>
                <p>Peaceful reading area.</p>
            </div>

        </div>
    </section>

    <!-- Membership -->
    <section id="membership">
        <h2>Library Membership</h2>

        <form>

            <label>Name:</label>
            <input type="text" placeholder="Enter your name">

            <label>Email:</label>
            <input type="email" placeholder="Enter your email">

            <label>Department:</label>
            <input type="text" placeholder="Enter your department">

            <label>Membership Type:</label>

            <select>
                <option>Student</option>
                <option>Faculty</option>
            </select>

            <button type="submit">Register</button>

        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Digital Library</p>
    </footer>

</body>
</html>
