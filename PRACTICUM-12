<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Digital Library API</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f2f2f2;
        }

        header {
            background-color: #4CAF50;
            color: white;
            text-align: center;
            padding: 25px;
        }

        section {
            padding: 25px;
            margin: 20px;
            background-color: white;
            border: 1px solid #ccc;
        }

        button {
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
            margin-bottom: 20px;
        }

        button:hover {
            background-color: #388E3C;
        }

        #loading {
            display: none;
            padding: 15px;
            text-align: center;
        }

        #error {
            display: none;
            color: red;
            padding: 15px;
        }

        #bookContainer {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .book {
            border: 1px solid #ccc;
            padding: 15px;
            background-color: #fafafa;
        }

        .book p {
            margin: 8px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #4CAF50;
            color: white;
        }

        @media (max-width: 700px) {

            #bookContainer {
                grid-template-columns: 1fr;
            }

            section {
                margin: 10px;
            }

            table {
                overflow-x: auto;
                display: block;
            }
        }

    </style>
</head>

<body>

    <header>

        <h1>Digital Library</h1>

        <p>Online Library Book Information</p>

    </header>


    <section>

        <h2>Library Books</h2>

        <button id="loadBtn">
            Load Books
        </button>


        <!-- Loading message -->
        <div id="loading">

            <p>Loading books...</p>

        </div>


        <!-- Error message -->
        <div id="error">

            <p>Unable to load books.</p>

        </div>


        <!-- Book data -->
        <div id="bookContainer">

        </div>

    </section>


    <script>

        const loadBtn = document.getElementById("loadBtn");

        const loading = document.getElementById("loading");

        const error = document.getElementById("error");

        const bookContainer =
            document.getElementById("bookContainer");


        // Button click
        loadBtn.addEventListener("click", loadBooks);


        // Async function
        async function loadBooks() {

            loading.style.display = "block";

            error.style.display = "none";

            bookContainer.innerHTML = "";


            try {

                // Fetch API data
                const response = await fetch(
                    "https://jsonplaceholder.typicode.com/posts"
                );


                // Check response
                if (!response.ok) {

                    throw new Error("API request failed");

                }


                // Convert response to JSON
                const data = await response.json();


                // Display only first 6 books
                data.slice(0, 6).forEach(function(book, index) {

                    // Create div
                    const bookDiv =
                        document.createElement("div");

                    bookDiv.className = "book";


                    // Create title
                    const title =
                        document.createElement("p");

                    title.textContent =
                        "Book: " + book.title;


                    // Create author
                    const author =
                        document.createElement("p");

                    author.textContent =
                        "Author: Library Author " + (index + 1);


                    // Create category
                    const category =
                        document.createElement("p");

                    category.textContent =
                        "Category: Computer Science";


                    // Add elements
                    bookDiv.appendChild(title);

                    bookDiv.appendChild(author);

                    bookDiv.appendChild(category);


                    // Add book to webpage
                    bookContainer.appendChild(bookDiv);

                });

            }


            catch (errorMessage) {

                console.log(errorMessage);

                error.style.display = "block";

            }


            finally {

                loading.style.display = "none";

            }

        }

    </script>

</body>

</html>
