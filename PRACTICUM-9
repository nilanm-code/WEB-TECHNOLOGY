<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Digital Library</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
        }

        /* Navigation */
        nav {
            background-color: #222;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        /* Header */
        header {
            background-color: #4CAF50;
            color: white;
            text-align: center;
            padding: 40px;
            animation: slideDown 1s;
        }

        /* Animation */
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section {
            padding: 30px;
            text-align: center;
        }

        /* Cards */
        .cards {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .card {
            background-color: white;
            width: 200px;
            padding: 20px;
            border-radius: 10px;

            transition: transform 0.3s, opacity 0.3s;
        }

        /* Hover effect */
        .card:hover {
            transform: scale(1.05);
            opacity: 0.85;
        }

        .card img {
            width: 100px;
            height: 100px;
        }

        /* Button */
        button {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
            cursor: pointer;

            transition: transform 0.3s;
        }

        button:hover {
            transform: scale(1.1);
        }

        /* Information box */
        #info {
            display: none;
            background-color: white;
            padding: 20px;
            margin: 20px auto;
            max-width: 500px;
            border-radius: 10px;
            animation: fadeIn 0.5s;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        /* Notification */
        #notification {
            display: none;
            background-color: #333;
            color: white;
            padding: 15px;
            position: fixed;
            bottom: 20px;
            right: 20px;
            border-radius: 5px;
        }

        /* Active class */
        .show {
            display: block !important;
        }

        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 15px;
        }

    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#books">Books</a>
        <a href="#facilities">Facilities</a>
    </nav>


    <!-- Header -->
    <header id="home">

        <h1>Digital Library</h1>

        <p>
            Explore thousands of books and digital resources
        </p>

        <button id="infoBtn">
            Show Library Information
        </button>

    </header>


    <!-- Information Section -->
    <section>

        <div id="info">

            <h2>About Our Library</h2>

            <p>
                Our digital library provides books, e-books,
                study materials and online resources for students
                and faculty.
            </p>

        </div>

    </section>


    <!-- Books -->
    <section id="books">

        <h2>Popular Books</h2>

        <div class="cards">

            <div class="card">

                <img src="https://via.placeholder.com/100"
                     alt="Programming Book">

                <h3>Programming</h3>

                <span>Python and C Programming</span>

            </div>


            <div class="card">

                <img src="https://via.placeholder.com/100"
                     alt="AI Book">

                <h3>Artificial Intelligence</h3>

                <span>AI and Machine Learning</span>

            </div>


            <div class="card">

                <img src="https://via.placeholder.com/100"
                     alt="Web Technology Book">

                <h3>Web Technology</h3>

                <span>HTML, CSS and JavaScript</span>

            </div>

        </div>

    </section>


    <!-- Facilities -->
    <section id="facilities">

        <h2>Library Facilities</h2>

        <div class="cards">

            <div class="card">

                <h3>📚 E-Books</h3>

                <span>Digital books available online.</span>

            </div>


            <div class="card">

                <h3>💻 Computer Lab</h3>

                <span>Computers available for students.</span>

            </div>


            <div class="card">

                <h3>🌐 Free Wi-Fi</h3>

                <span>Internet access for learning.</span>

            </div>

        </div>

        <br>

        <button id="notifyBtn">
            Check Library Availability
        </button>

    </section>


    <!-- Notification -->
    <div id="notification">

        <span>Library is currently open!</span>

    </div>


    <footer>

        <p>© 2026 Digital Library</p>

    </footer>


    <script>

        // Get elements
        const infoBtn = document.getElementById("infoBtn");
        const info = document.getElementById("info");

        const notifyBtn = document.getElementById("notifyBtn");
        const notification = document.getElementById("notification");


        // Show / hide information
        infoBtn.addEventListener("click", function() {

            info.classList.toggle("show");

        });


        // Show notification
        notifyBtn.addEventListener("click", function() {

            notification.classList.add("show");

            setTimeout(function() {

                notification.classList.remove("show");

            }, 3000);

        });

    </script>

</body>
</html>
